---
import { directions } from '../data/master';
---

<section id="issues" class="soft-bg">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <span class="section-eyebrow">Направления</span>
      <h2>
        Карты, рисунок, сказка и&nbsp;аромат: направления,
        в&nbsp;которых я&nbsp;работаю.
      </h2>
      <p>
        Очно в&nbsp;Барнауле и&nbsp;онлайн. Если не&nbsp;знаете, что выбрать,
        напишите: подскажу, с&nbsp;чего начать.
      </p>
    </header>

    <div class="grid">
      {directions.map((d, i) => (
        <article class="group" data-reveal data-reveal-delay={Math.min(i * 90, 360)}>
          <span class="kind">{d.kind}</span>
          <h3>{d.title}</h3>
          <p class="text">{d.text}</p>
          <p class="note">{d.note}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .group {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 26px 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .group:hover {
    transform: translateY(-2px);
    border-color: var(--accent-line);
    box-shadow: 0 20px 36px -24px rgba(31, 25, 21, 0.15);
  }
  .kind {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .group h3 {
    font-family: var(--font-serif);
    font-size: 21px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0;
    font-weight: 400;
  }
  .text {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-muted);
    margin: 0;
    flex-grow: 1;
  }
  .note {
    margin: 4px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--ink-soft);
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
