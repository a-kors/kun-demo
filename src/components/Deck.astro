---
import { master, deck } from '../data/master';
---

<section id="deck" class="compact deck">
  <div class="wrap">
    <div class="panel" data-reveal>
      <div class="text">
        <span class="section-eyebrow">Авторская колода МАК</span>
        <h2>{deck.title}</h2>
        <p class="lead">{deck.lead}</p>
        <p class="note">{deck.note}</p>

        <dl class="facts">
          {deck.facts.map((f) => (
            <div>
              <dt>{f.value}</dt>
              <dd>{f.label}</dd>
            </div>
          ))}
        </dl>

        <a class="btn btn-primary" href={master.whatsapp}>
          <span>Узнать о&nbsp;колоде в&nbsp;WhatsApp</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="uses">
        <span class="uses-label">Для чего</span>
        <ul>
          {deck.uses.map((u) => <li>{u}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .deck {
    padding-top: clamp(40px, 5vw, 80px);
    padding-bottom: clamp(40px, 5vw, 80px);
  }
  .panel {
    background: var(--ink);
    color: #ffffff;
    border-radius: var(--radius-lg);
    padding: clamp(36px, 6vw, 72px) clamp(28px, 5vw, 64px);
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .panel > * {
    min-width: 0;
  }
  .section-eyebrow {
    color: var(--accent-line);
  }
  h2 {
    color: #ffffff;
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.05;
    margin: 14px 0 20px;
    font-style: italic;
  }
  .lead {
    color: rgba(255, 255, 255, 0.86);
    font-size: 18px;
    line-height: 1.6;
    margin: 0 0 12px;
  }
  .note {
    color: rgba(255, 255, 255, 0.62);
    font-size: 15px;
    margin: 0;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 32px 0 32px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .facts div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .facts dt {
    font-family: var(--font-serif);
    font-size: 34px;
    line-height: 1;
    color: var(--accent-line);
  }
  .facts dd {
    margin: 0;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
  }
  .btn-primary {
    background: var(--accent);
    color: #ffffff;
  }
  .uses {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    padding: 28px 26px;
  }
  .uses-label {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-line);
  }
  .uses ul {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .uses li {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.86);
    padding-left: 18px;
    position: relative;
  }
  .uses li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-line);
  }

  @media (max-width: 860px) {
    .panel {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
