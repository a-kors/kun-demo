---
import { Image } from 'astro:assets';
import aboutImg from '../assets/photos/about.jpg';
import { bioFacts, education } from '../data/master';
---

<section id="about">
  <div class="wrap">
    <div class="grid">
      <figure class="photo" data-reveal>
        <Image
          src={aboutImg}
          alt="Екатерина Кун в творческой студии"
          widths={[480, 720, 960]}
          sizes="(max-width: 860px) 440px, 460px"
          format="webp"
          quality={88}
          loading="lazy"
          class="photo-img"
        />
      </figure>

      <div class="copy" data-reveal data-reveal-delay="140">
        <span class="section-eyebrow">Обо мне</span>
        <h2>
          Учитель английского по&nbsp;первому образованию, <em>психолог</em>
          по&nbsp;второму.
        </h2>

        <p class="lead">
          Помимо этого специалист по&nbsp;метафорическим ассоциативным картам,
          сказкотерапевт, инструктор нейрографики, ароматерапевт, нейропедагог
          и&nbsp;автор колоды метафорических карт «Цветы Друидов».
        </p>

        <p>
          Говорю на&nbsp;русском, английском и&nbsp;турецком, поэтому
          консультирую и&nbsp;тех, кому проще говорить о&nbsp;себе
          по&#8209;английски.
        </p>

        <dl class="facts">
          {bioFacts.map((f) => (
            <div>
              <dt>{f.value}</dt>
              <dd>{f.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="edu" data-reveal>
      <h3>Образование и&nbsp;повышение квалификации</h3>
      <ul>
        {education.map((e) => (
          <li>
            <span class="year">{e.year}</span>
            <span class="place">{e.place}</span>
            <span class="program">{e.program}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .grid > * {
    min-width: 0;
  }
  .photo {
    margin: 0;
  }
  .photo-img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    display: block;
  }
  h2 {
    margin-bottom: 28px;
  }
  h2 em {
    font-style: italic;
    color: var(--accent);
  }
  .lead {
    font-size: 18px;
    color: var(--ink);
    margin-bottom: 18px;
    line-height: 1.6;
  }
  .copy p {
    color: var(--ink-muted);
    margin-bottom: 18px;
    font-size: 17px;
    line-height: 1.65;
  }
  .copy p.lead {
    color: var(--ink);
  }

  .facts {
    margin: 36px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .facts div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .facts dt {
    font-family: var(--font-serif);
    font-size: 26px;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.05;
    white-space: nowrap;
  }
  .facts dd {
    margin: 0;
    font-size: 13px;
    color: var(--ink-muted);
  }

  .edu {
    margin-top: clamp(56px, 7vw, 96px);
    padding: clamp(28px, 4vw, 48px);
    background: var(--bg-soft);
    border-radius: var(--radius-lg);
  }
  .edu h3 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(22px, 2.4vw, 28px);
    letter-spacing: -0.015em;
    margin: 0 0 24px;
  }
  .edu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .edu li {
    display: grid;
    grid-template-columns: 140px 1fr 1.1fr;
    gap: 6px 24px;
    padding: 14px 0;
    border-top: 1px solid var(--line-strong);
    font-size: 15px;
    line-height: 1.45;
  }
  .year {
    color: var(--accent);
    font-family: var(--font-serif);
    white-space: nowrap;
  }
  .place {
    color: var(--ink);
  }
  .program {
    color: var(--ink-muted);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .photo {
      max-width: 440px;
      width: 100%;
      margin: 0 auto;
    }
    .edu li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
  @media (max-width: 560px) {
    .facts {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
