---
import { master, reviews } from '../data/master';
---

<section id="reviews" class="rv">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <span class="section-eyebrow">Отзывы</span>
      <h2>Что пишут клиенты после встреч.</h2>
      <p>
        Отзывы из&nbsp;моей анкеты на&nbsp;b17.ru, без сокращений
        и&nbsp;правок.
      </p>
    </header>

    <div class="rv__cols">
      {[reviews.slice(0, 1), reviews.slice(1)].map((stack, si) => (
        <div class="rv__stack">
          {stack.map((r, i) => (
            <figure class="rc" data-reveal data-reveal-delay={Math.min((si + i) * 80, 240)}>
              <span class="rc__mark" aria-hidden="true">“</span>
              <blockquote>{r.text}</blockquote>
              <figcaption>
                <span class="rc__avatar" aria-hidden="true">{r.name.slice(0, 1)}</span>
                <span class="rc__who">
                  <span class="rc__name">{r.name}</span>
                  <span class="rc__meta">{r.date} · {r.topic}</span>
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      ))}
    </div>

    <div class="rv__footer">
      <a class="btn btn-ghost" href={master.b17Reviews} target="_blank" rel="noopener">
        Все отзывы на&nbsp;b17.ru →
      </a>
    </div>
  </div>
</section>

<style>
  .rv {
    background: var(--bg-soft);
  }
  .rv__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    align-items: start;
  }
  .rv__stack {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .rc {
    margin: 0;
    padding: 30px 30px 26px;
    background: #ffffff;
    border-radius: 18px;
    box-shadow:
      0 1px 2px rgba(31, 25, 21, 0.05),
      0 6px 20px rgba(31, 25, 21, 0.06);
    position: relative;
  }
  .rc__mark {
    position: absolute;
    top: 6px;
    right: 22px;
    font-family: var(--font-serif);
    font-size: 84px;
    line-height: 1;
    color: var(--accent);
    opacity: 0.18;
  }
  blockquote {
    margin: 0 0 22px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink);
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }
  .rc__avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: 17px;
    flex-shrink: 0;
  }
  .rc__who {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .rc__name {
    font-weight: 500;
    font-size: 15px;
  }
  .rc__meta {
    font-size: 13px;
    color: var(--ink-muted);
  }
  .rv__footer {
    display: flex;
    justify-content: center;
    margin-top: 18px;
  }

  @media (max-width: 760px) {
    .rv__cols {
      grid-template-columns: 1fr;
    }
    .rc {
      padding: 26px 22px 22px;
    }
  }
</style>
